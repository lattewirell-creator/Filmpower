{
  "crons": [
    {
      "path": "/api/bot",
      "schedule": "0 5 * * *"
    }
  ],
  "functions": {
    "api/bot.js": {
      "maxDuration": 60
    },
    "api/users.js": {
      "maxDuration": 60
    }
  },
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- . ':(exclude).github' ':(exclude)scripts' ':(exclude)README.md'",
  "rewrites": [
    {
      "source": "/blogg",
      "destination": "/nyheter/index.html"
    },
    {
      "source": "/blogg/",
      "destination": "/nyheter/index.html"
    },
    {
      "source": "/sida/:slug",
      "destination": "/api/me?sida=:slug"
    }
  ]
}
